  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="copy /Y &quot;$(TargetPath)&quot; &quot;$(APPDATA)\Dungeon Helper\plugins\RotationHelper\RotationHelper.dll&quot;" />
  </Target>
</Project>
